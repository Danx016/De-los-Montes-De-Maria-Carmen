<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Usuario - De los Montes de María</title>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="../css/registro.css">
    <!-- Google Identity Services -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark-mode');
      }
    </script>
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <h1>Crear Cuenta</h1>
            <p>Completa tus datos para registrarte</p>
        </div>


        <form id="registerForm" class="register-form" action="/register" method="post">
            <div class="form-group">
                <label for="name">Nombre Completo</label>
                <input type="text" id="name" name="name" placeholder="Ej: Juan Pérez" required>
            </div>
            
            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" name="email" placeholder="Ej: usuario@ejemplo.com" required>
            </div>
            
            <div class="form-group">
                <label for="apodo">Nombre de Usuario</label>
                <input type="text" id="apodo" name="apodo" placeholder="Crea un nombre de usuario" required>
                <div id="username-feedback" class="feedback-msg" style="display: none;"></div>
            </div>
            
            <div class="form-group">
                <label for="password">Contraseña</label>
                <div class="password-input">
                    <input type="password" id="password" name="password" placeholder="Mínimo 8 caracteres" required>
                    <i class="fa fa-eye toggle-password" id="toggle-password-btn"></i>
                </div>
                <!-- Password Strength Indicator -->
                <div class="password-strength" id="password-strength-container" style="display: none;">
                    <div class="strength-bar"><div id="strength-bar-fill" class="strength-bar-fill"></div></div>
                    <div class="strength-text" id="strength-text">Insegura</div>
                    <div class="password-requirements">
                        <small id="req-length" class="req-item"><i class="fa-regular fa-circle-xmark text-danger"></i> Mínimo 8 caracteres</small>
                        <small id="req-upper" class="req-item"><i class="fa-regular fa-circle-xmark text-danger"></i> Una mayúscula (A-Z)</small>
                        <small id="req-number" class="req-item"><i class="fa-regular fa-circle-xmark text-danger"></i> Un número (0-9)</small>
                        <small id="req-special" class="req-item"><i class="fa-regular fa-circle-xmark text-danger"></i> Un carácter especial (ej: !@#$)</small>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label for="confirmPassword">Confirmar Contraseña</label>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repite tu contraseña" required>
            </div>
            
            <div class="form-group terms">
                <input type="checkbox" id="terms" name="terms" required>
                <label for="terms">Acepto los <a href="#">términos y condiciones</a> y la <a href="#">política de privacidad</a></label>
            </div>
            
            <button type="submit" class="register-btn">Registrarse</button>

            <div class="google-separator" style="display: flex; align-items: center; justify-content: center; margin: 18px 0; color: #888;">
              <span style="border-bottom: 1px dashed #ccc; width: 42%; margin-right: 10px;"></span>
              <span style="font-size: 0.9em; font-weight: 600; text-transform: uppercase; color: #94a3b8;">o</span>
              <span style="border-bottom: 1px dashed #ccc; width: 42%; margin-left: 10px;"></span>
            </div>

            <div style="display: flex; justify-content: center; margin-bottom: 18px; width: 100%;">
              <div id="g_id_onload"
                   data-client_id="<%= googleClientId %>"
                   data-context="signup"
                   data-ux_mode="popup"
                   data-callback="handleCredentialResponse"
                   data-auto_prompt="false">
              </div>

              <div class="g_id_signin"
                   data-type="standard"
                   data-shape="rectangular"
                   data-theme="outline"
                   data-text="signup_with"
                   data-size="large"
                   data-logo_alignment="left"
                   data-width="320">
              </div>
            </div>
            
            <div class="login-link">
                ¿Ya tienes cuenta? <a href="/login">Inicia sesión aquí</a>
            </div>
        </form>
    </div>

    <input type="hidden" id="csrfToken" value="<%= csrfToken %>" />

    <script src="../js/registros.js"></script>
    <script src="../js/main.js"></script>
    <script>
      async function handleCredentialResponse(response) {
        const credential = response.credential;
        
        const loader = document.getElementById("global-loader");
        const loaderIcon = document.getElementById("loader-icon");
        const loaderText = document.getElementById("loader-text");

        if (loader) {
            loader.style.display = "flex";
            if (loaderIcon) {
                loaderIcon.className = "fa fa-spinner fa-spin fa-3x";
                loaderIcon.style.color = "#3ba75a";
            }
            if (loaderText) {
                loaderText.textContent = "Registrando con Google...";
                loaderText.style.color = "";
            }
        }

        try {
            const csrfInput = document.getElementById('csrfToken') || document.querySelector('input[name="_csrf"]');
            const csrfToken = csrfInput ? csrfInput.value : '';

            const res = await fetch('/login/google', {
                method: 'POST',
                credentials: 'include',
                headers: { 
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken
                },
                body: JSON.stringify({ credential })
            });
            const data = await res.json();

            if (res.ok && data.idUser) {
                // Guardar el token JWT y datos del usuario
                const user = {
                    idUser: data.idUser,
                    nombreUser: data.nombreUser,
                    emailUser: data.emailUser,
                    username: data.username,
                    rolUser: data.rolUser,
                    avatar: data.avatar || '../img/logo vaca.png',
                    token: data.token
                };
                localStorage.setItem('user', JSON.stringify(user));

                if (loaderIcon) {
                    loaderIcon.className = "fa-solid fa-circle-check fa-3x";
                    loaderIcon.style.color = "#10b981";
                }
                if (loaderText) {
                    loaderText.textContent = "¡Registro exitoso! Bienvenido.";
                    loaderText.style.color = "#10b981";
                }

                // Esperar 1.2 segundos y redirigir
                setTimeout(() => {
                    if (loader) loader.style.display = "none";
                    const rolNum = Number(data.rolUser);
                    const isAdmin = (rolNum === 1 || data.username === 'admin');
                    const isVendedor = (rolNum === 2);
                    const isSoporte = (rolNum === 4);

                    if (isAdmin) {
                        window.location.href = '/admin';
                    } else if (isVendedor) {
                        window.location.href = '/vendedor';
                    } else if (isSoporte) {
                        window.location.href = '/admin/soporte';
                    } else {
                        window.location.href = '/';
                    }
                }, 1200);
            } else {
                if (loaderIcon) {
                    loaderIcon.className = "fa-solid fa-circle-xmark fa-3x";
                    loaderIcon.style.color = "#ef4444";
                }
                if (loaderText) {
                    loaderText.textContent = data.message || "Error al registrarse con Google.";
                    loaderText.style.color = "#ef4444";
                }
                setTimeout(() => {
                    if (loader) loader.style.display = "none";
                }, 2500);
            }
        } catch (error) {
            console.error(error);
            if (loaderIcon) {
                loaderIcon.className = "fa-solid fa-circle-xmark fa-3x";
                loaderIcon.style.color = "#ef4444";
            }
            if (loaderText) {
                loaderText.textContent = "Error de red al conectar con Google.";
                loaderText.style.color = "#ef4444";
            }
            setTimeout(() => {
                if (loader) loader.style.display = "none";
            }, 2500);
        }
      }
    </script>
</body>
<!-- Loader global -->
<div id="global-loader" style="display:none;">
  <div class="loader-backdrop"></div>
  <div class="loader-spinner">
    <i id="loader-icon" class="fa fa-spinner fa-spin fa-3x"></i>
    <p id="loader-text">Cargando...</p>
  </div>
</div>
</html>
