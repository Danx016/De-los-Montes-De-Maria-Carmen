# ========== CONFIGURACIÓN DE ENTORNO ==========
# Copia este archivo como .env y rellena tus propios valores.
# NUNCA subas el .env real a GitHub.

# --- Servidor ---
PORT=3000
NODE_ENV=development
JWT_SECRET=escribe_aqui_un_secreto_largo_y_seguro

# --- Correo Electrónico (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_google

# --- Google OAuth ---
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# --- ePayco Pasarela de Pago (Sandbox) ---
EPAYCO_P_CUST_ID_CLIENTE=tu_cust_id
EPAYCO_P_KEY=tu_p_key_de_epayco
EPAYCO_PUBLIC_KEY=tu_public_key_de_epayco
EPAYCO_TEST=true

# --- Wompi Pasarela de Pago ---
WOMPI_PUBLIC_KEY=pub_test_tu_clave_publica
WOMPI_INTEGRITY_KEY=test_integrity_tu_clave_de_integridad

# --- URL Base (para enlaces en correos) ---
BASE_URL=http://localhost:3000

# --- Asistente de IA (OpenRouter API) ---
# Obtén tu clave en: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-tu_clave_aqui
OPENROUTER_MODEL=openrouter/free

# --- Base de Datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=agro_campo

