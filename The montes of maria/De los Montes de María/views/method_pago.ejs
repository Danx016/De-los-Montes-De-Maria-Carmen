<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pasarela de Pago Segura | De los Montes de María</title>
    <script>
      if (localStorage.getItem("theme") === "dark") {
        document.documentElement.classList.add("dark-mode");
      }
    </script>
    <link rel="stylesheet" href="../css/style.css" />
    <link rel="stylesheet" href="../css/method_pago.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <!-- SDK Widget de Wompi -->
    <script type="text/javascript" src="https://checkout.wompi.co/widget.js"></script>
  </head>
  <body>
    <%- include('partials/header') %>
    
    <main class="checkout-main">
      <h2 class="welcome-heading">Hola, <span id="user-name"></span></h2>
      
      <div class="checkout-layout">
        <!-- Columna Izquierda: Formulario de Pago y Métodos -->
        <div class="checkout-form-container">
          <div class="payment-methods">
            <h3>Método de Pago</h3>
            <p class="subtitle">Seleccione su método de pago preferido:</p>
            <ul>
              <li>
                <input
                  type="radio"
                  id="pago-contraentrega"
                  name="payment-method"
                  value="Pago Contraentrega"
                  checked
                />
                <label for="pago-contraentrega" style="display:flex; flex-direction:column; align-items:center;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    <span>Pago Contraentrega</span>
                  </div>
                </label>
              </li>
              <li>
                <input
                  type="radio"
                  id="pago-wompi"
                  name="payment-method"
                  value="Wompi"
                />
                <label for="pago-wompi" style="display:flex; flex-direction:column; align-items:center;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-credit-card"></i>
                    <span>Tarjeta / Transferencia</span>
                  </div>
                  <span style="font-size:0.75em; color:#6b7280; margin-top:3px;">Powered by Wompi</span>
                </label>
              </li>
              <li>
                <input
                  type="radio"
                  id="agro-creditos"
                  name="payment-method"
                  value="Agro-Créditos"
                />
                <label for="agro-creditos" style="display:flex; flex-direction:column; align-items:center;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-coins"></i>
                    <span>Agro-Créditos</span>
                  </div>
                  <span id="user-credits-display" style="font-size:0.8em; color:#10b981; font-weight:bold; margin-top:5px;"></span>
                </label>
              </li>
            </ul>
          </div>

          <!-- Card Preview Wrapper Removed -->

          <!-- Detalles del Formulario (Se inyecta dinámicamente) -->
          <div id="form-details"></div>

          <div class="container-btn">
            <button type="submit" id="pay-btn">Pagar Pedido</button>
            <a href="/carrito" id="back-btn">Volver al Carrito</a>
          </div>
        </div>

        <!-- Columna Derecha: Resumen de la Orden -->
        <div class="order-summary">
          <h3>Resumen del Pedido</h3>
          
          <!-- Lista Dinámica de Productos -->
          <div id="summary-items-list" class="summary-items-list">
            <!-- Se llena con JS -->
          </div>

          <div class="summary-divider"></div>

          <!-- Totales -->
          <div class="summary-totals">
            <div class="summary-row">
              <span>Subtotal:</span>
              <span id="summary-subtotal">$0</span>
            </div>
            <div class="summary-row">
              <span>Costo de Envío:</span>
              <span id="summary-shipping">Gratis</span>
            </div>
            <div class="summary-row total">
              <span>Total:</span>
              <span id="summary-total">$0</span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer>
        <p>&copy; 2026 De los Montes de María. Todos los derechos reservados.</p>
    </footer>

    <!-- Scripts de la Aplicación -->
    <script src="../js/main.js"></script>
    <script src="../js/method_page.js"></script>
  </body>
  
  <!-- Loader global -->
  <div id="global-loader" style="display:none;">
    <div class="loader-backdrop"></div>
    <div class="loader-spinner">
      <i id="loader-icon" class="fa fa-spinner fa-spin fa-3x" style="color: #4f46e5; transition: all 0.3s ease;"></i>
      <p id="loader-text" style="font-weight: 600; margin-top: 15px; font-size: 1.1em; transition: all 0.3s ease;">Procesando Pago...</p>
    </div>
  </div>
</html>
